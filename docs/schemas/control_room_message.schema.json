{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edcontrolroom.local/schemas/control_room_message.schema.json",
  "title": "EDControlRoom Control Room Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "message_type", "message_id", "timestamp", "payload"],
  "properties": {
    "schema": {
      "const": "edcontrolroom.control_room_message"
    },
    "version": {
      "const": 1
    },
    "message_type": {
      "enum": [
        "event.connection_ready",
        "event.active_operator_changed",
        "event.activity_log_appended",
        "event.announcement_emitted",
        "command.request_active_operator",
        "command.submit_input",
        "command.dispatch_destination",
        "command.dispatch_haul_loop",
        "command.dispatch_travel",
        "command.dispatch_spansh_route",
        "command.dispatch_route_all_in_one",
        "command.search_haul_routes",
        "command.select_trade_route",
        "command.cancel_active_routine",
        "response.success",
        "response.error"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_message_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.request_active_operator" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_request_active_operator_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.submit_input" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_submit_input_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.dispatch_destination" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_dispatch_destination_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.dispatch_haul_loop" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_dispatch_haul_loop_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.dispatch_travel" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_dispatch_travel_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.dispatch_spansh_route" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_dispatch_spansh_route_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.dispatch_route_all_in_one" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_dispatch_route_all_in_one_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.search_haul_routes" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_search_haul_routes_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.select_trade_route" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_select_trade_route_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "event.connection_ready" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/event_connection_ready_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "command.cancel_active_routine" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/command_cancel_active_routine_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "event.announcement_emitted" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/event_announcement_emitted_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "event.active_operator_changed" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/event_active_operator_changed_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "event.activity_log_appended" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/event_activity_log_appended_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "response.success" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/response_success_payload" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": { "const": "response.error" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/response_error_payload" }
        }
      }
    }
  ],
  "$defs": {
    "string_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "client_role": {
      "enum": ["active_operator", "observer"]
    },
    "activity_log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "timestamp", "message_text"],
      "properties": {
        "entry_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "message_text": { "type": "string", "minLength": 1 },
        "severity": { "type": ["string", "null"] }
      }
    },
    "command_history_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_command", "command_name", "arguments", "timestamp"],
      "properties": {
        "raw_command": { "type": "string", "minLength": 1 },
        "command_name": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        },
        "timestamp": { "type": "string" }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_id", "severity", "message_text"],
      "properties": {
        "alert_id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "minLength": 1 },
        "message_text": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "command_request_active_operator_payload": {
      "type": "object",
      "additionalProperties": false
    },
    "command_submit_input_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_input"],
      "properties": {
        "raw_input": { "type": "string" },
        "skip_delay": { "type": ["boolean", "null"] }
      }
    },
    "command_dispatch_destination_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "galaxy_map_settle"],
      "properties": {
        "destination": { "type": "string", "minLength": 1 },
        "galaxy_map_settle": { "type": "number" },
        "skip_delay": { "type": "boolean" },
        "raw_command": { "type": ["string", "null"] }
      }
    },
    "command_dispatch_haul_loop_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skip_delay": { "type": "boolean" },
        "raw_command": { "type": ["string", "null"] },
        "trade_route": { "$ref": "#/$defs/trade_route" }
      }
    },
    "command_dispatch_travel_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "station"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "station": { "type": "string", "minLength": 1 },
        "on_land": { "type": "boolean" },
        "skip_delay": { "type": "boolean" },
        "raw_command": { "type": ["string", "null"] }
      }
    },
    "command_dispatch_spansh_route_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id"],
      "properties": {
        "route_id": { "type": "string", "minLength": 1 },
        "station": { "type": "string" },
        "skip_delay": { "type": "boolean" },
        "raw_command": { "type": ["string", "null"] }
      }
    },
    "command_dispatch_route_all_in_one_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "range", "galaxy_map_settle"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "range": { "type": "number" },
        "efficiency": { "type": "integer" },
        "supercharge_multiplier": { "type": "integer" },
        "galaxy_map_settle": { "type": "number" },
        "navroute_wait_seconds": { "type": "number" },
        "compare_retry_attempts": { "type": "integer" },
        "station": { "type": "string" },
        "skip_delay": { "type": "boolean" },
        "raw_command": { "type": ["string", "null"] }
      }
    },
    "command_search_haul_routes_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string" },
        "system_name": { "type": "string" },
        "destination": { "type": "string" },
        "destination_filter": { "type": "string" },
        "cargo_capacity": { "type": "string" },
        "max_route_distance_ly": { "type": "string" },
        "max_station_distance_ls": { "type": "string" },
        "metric": { "type": "string" },
        "order_by": { "type": "string" }
      }
    },
    "command_select_trade_route_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route"],
      "properties": {
        "route": { "$ref": "#/$defs/trade_route" }
      }
    },
    "command_cancel_active_routine_payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["toggle", "after_run", "now"]
        }
      }
    },
    "trade_route": {
      "type": "object",
      "additionalProperties": true,
      "required": ["index", "from_station", "from_system", "to_station", "to_system"],
      "properties": {
        "index": { "type": "integer" },
        "from_station": { "type": "string", "minLength": 1 },
        "from_system": { "type": "string", "minLength": 1 },
        "to_station": { "type": "string", "minLength": 1 },
        "to_system": { "type": "string", "minLength": 1 },
        "source_buy_commodity": { "type": ["string", "null"] },
        "target_buy_commodity": { "type": ["string", "null"] },
        "from_station_distance": { "type": ["string", "null"] },
        "to_station_distance": { "type": ["string", "null"] },
        "distance_from_system": { "type": ["string", "null"] },
        "route_distance": { "type": ["string", "null"] },
        "profit_per_unit": { "type": ["string", "null"] },
        "profit_per_trip": { "type": ["string", "null"] },
        "profit_per_hour": { "type": ["string", "null"] },
        "updated": { "type": ["string", "null"] },
        "raw_text": { "type": "string" },
        "url_links": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "response_capabilities_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_names",
        "supported_client_roles",
        "supported_message_types",
        "supported_command_message_types",
        "supported_event_message_types",
        "supported_response_message_types",
        "minimum_client_version",
        "server_version",
        "message_schema_url",
        "browser_probe_url",
        "authentication_required",
        "authentication_scheme",
        "authentication_supported_transports",
        "authentication_query_parameter_name"
      ],
      "properties": {
        "capability_names": { "$ref": "#/$defs/string_list" },
        "supported_client_roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/client_role" }
        },
        "supported_message_types": { "$ref": "#/$defs/string_list" },
        "supported_command_message_types": { "$ref": "#/$defs/string_list" },
        "supported_event_message_types": { "$ref": "#/$defs/string_list" },
        "supported_response_message_types": { "$ref": "#/$defs/string_list" },
        "minimum_client_version": { "type": "string", "minLength": 1 },
        "server_version": { "type": "string", "minLength": 1 },
        "message_schema_url": { "type": "string", "minLength": 1 },
        "browser_probe_url": { "type": "string", "minLength": 1 },
        "authentication_required": { "type": "boolean" },
        "authentication_scheme": { "type": "string", "minLength": 1 },
        "authentication_supported_transports": { "$ref": "#/$defs/string_list" },
        "authentication_query_parameter_name": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "event_connection_ready_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "server_name", "server_version", "client_role", "capability_names"],
      "properties": {
        "session_id": { "type": "string", "minLength": 1 },
        "server_name": { "type": "string", "minLength": 1 },
        "server_version": { "type": "string", "minLength": 1 },
        "client_role": { "$ref": "#/$defs/client_role" },
        "capability_names": { "$ref": "#/$defs/string_list" }
      }
    },
    "event_announcement_emitted_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["announcement_id", "message_text", "message_values"],
      "properties": {
        "announcement_id": { "type": "string", "minLength": 1 },
        "message_text": { "type": "string", "minLength": 1 },
        "message_values": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "event_active_operator_changed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_operator_session_id", "active_operator_client_name"],
      "properties": {
        "active_operator_session_id": { "type": ["string", "null"], "minLength": 1 },
        "active_operator_client_name": { "type": ["string", "null"], "minLength": 1 },
        "reason": { "type": ["string", "null"] }
      }
    },
    "event_operator_message_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message_text"],
      "properties": {
        "severity": { "type": "string", "minLength": 1 },
        "message_text": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "event_activity_log_appended_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "$ref": "#/$defs/activity_log_entry" }
      }
    },
    "event_routine_started_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "routine_name", "arguments"],
      "properties": {
        "routine_id": { "type": "string", "minLength": 1 },
        "routine_name": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "event_routine_progress_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "progress_message"],
      "properties": {
        "routine_id": { "type": "string", "minLength": 1 },
        "progress_message": { "type": "string", "minLength": 1 },
        "progress_detail": { "type": ["string", "null"] }
      }
    },
    "event_routine_failed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "failure_code", "failure_message"],
      "properties": {
        "routine_id": { "type": "string", "minLength": 1 },
        "failure_code": { "type": "string", "minLength": 1 },
        "failure_message": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "event_routine_completed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id", "completion_message"],
      "properties": {
        "routine_id": { "type": "string", "minLength": 1 },
        "completion_message": { "type": "string", "minLength": 1 },
        "result": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "event_routine_cancelled_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_id"],
      "properties": {
        "routine_id": { "type": "string", "minLength": 1 },
        "cancellation_reason": { "type": ["string", "null"] }
      }
    },
    "event_server_warning_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_code", "warning_message"],
      "properties": {
        "warning_code": { "type": "string", "minLength": 1 },
        "warning_message": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": ["string", "null"] }
      }
    },
    "response_authentication_result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated",
        "server_name",
        "server_version",
        "session_id",
        "client_role",
        "capability_names"
      ],
      "properties": {
        "authenticated": { "type": "boolean" },
        "server_name": { "type": "string", "minLength": 1 },
        "server_version": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "client_role": { "$ref": "#/$defs/client_role" },
        "capability_names": { "$ref": "#/$defs/string_list" },
        "operator_mode": { "type": ["string", "null"] }
      }
    },
    "response_success_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" },
        "message_text": { "type": ["string", "null"] },
        "result": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    },
    "response_error_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "error_message", "retryable"],
      "properties": {
        "error_code": { "type": "string", "minLength": 1 },
        "error_message": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": ["string", "null"] },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
