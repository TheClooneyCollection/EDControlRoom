# Replace placeholders before a real upload. Endpoint and bucket suffice for --dry-run.
EDCR_SNAPSHOT_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
EDCR_SNAPSHOT_BUCKET=<bucket>
EDCR_SNAPSHOT_ACCESS_KEY_ID=<access-key-id>
EDCR_SNAPSHOT_SECRET_ACCESS_KEY=<secret-access-key>
# Empty prefix puts objects at the bucket root.
EDCR_SNAPSHOT_PREFIX=
EDCR_SNAPSHOT_WORK_DIR=/var/lib/edcontrolroom/snapshots
EDCR_SNAPSHOT_KEEP=3
